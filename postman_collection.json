            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/schedules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacher_id\": 2,\n  \"room_id\": 1,\n  \"day_of_week\": 1,\n  \"start_time\": \"09:00:00\",\n  \"end_time\": \"10:30:00\",\n  \"target_jp\": 2,\n  \"subject\": \"Matematika\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "day_of_week: 1=Senin ... 7=Minggu"
          }
        },
        {
          "name": "Update Schedule",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/schedules/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacher_id\": 2,\n  \"room_id\": 1,\n  \"day_of_week\": 1,\n  \"start_time\": \"09:00:00\",\n  \"end_time\": \"10:30:00\",\n  \"target_jp\": 2,\n  \"subject\": \"Matematika Lanjut\"\n}"
            }
          }
        },
        {
          "name": "Delete (Nonaktifkan) Schedule",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/admin/schedules/1"
          }
        }
      ]
    },
    {
      "name": "Attendance (Guru - Flutter)",
      "item": [
        {
          "name": "Scan In (Guru Utama)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/attendance/scan-in",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_string\": \"ROOM-A1B2C3D4\"\n}"
            },
            "description": "Login sebagai guru (bukan admin) sebelum menjalankan request ini. Server mengikat presensi ke jadwal terdekat berdasarkan waktu SERVER, bukan waktu device."
          }
        },
        {
          "name": "Scan In (Mode Guru Pengganti / Inval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/attendance/scan-in",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_string\": \"ROOM-A1B2C3D4\",\n  \"substitute_for_id\": 2\n}"
            },
            "description": "substitute_for_id diisi dengan ID guru utama yang sedang cuti/berhalangan dan digantikan."
          }
        },
        {
          "name": "Scan Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/attendance/scan-out",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_string\": \"ROOM-A1B2C3D4\"\n}"
            }
          }
        },
        {
          "name": "My Attendance History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/attendance/history"
          }
        }
      ]
    },
