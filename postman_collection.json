{
  "info": {
    "name": "Absensi Guru QR - Backend API (Wahyu)",
    "description": "Koleksi endpoint API Sistem Absensi Jam Mengajar Guru berbasis QR Code. Import file ini ke Postman, lalu atur variable {{base_url}} dan jalankan 'Login' terlebih dahulu — token akan otomatis tersimpan ke {{token}} untuk dipakai request lainnya.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_nip",
      "value": "198000000001"
    },
    {
      "key": "admin_password",
      "value": "password123"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nip\": \"{{admin_nip}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "description": "Login menggunakan NIP + password. Response berisi JWT yang otomatis disimpan ke variable {{token}}."
          }
        }
      ]
    },
    {
      "name": "Admin - Teachers (Master Guru)",
      "item": [
        {
          "name": "List Teachers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/admin/teachers"
          }
        },
        {
          "name": "Create Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/teachers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Guru Baru\",\n  \"nip\": \"199900000099\",\n  \"email\": \"guru.baru@sekolah.sch.id\",\n  \"password\": \"password123\",\n  \"role\": \"guru\"\n}"
            }
          }
        },
        {
          "name": "Create Teacher (Guru Pengganti)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/teachers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dedi Guru Pengganti\",\n  \"nip\": \"199500000088\",\n  \"email\": \"dedi.inval@sekolah.sch.id\",\n  \"password\": \"password123\",\n  \"role\": \"guru_pengganti\"\n}"
            }
          }
        },
        {
          "name": "Update Teacher",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/teachers/2",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso, S.Pd\",\n  \"email\": \"budi@sekolah.sch.id\",\n  \"role\": \"guru\"\n}"
            }
          }
        },
        {
          "name": "Delete (Nonaktifkan) Teacher",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/admin/teachers/2"
          }
        }
      ]
    },
    {
      "name": "Admin - Rooms (Master Ruangan + QR)",
      "item": [
        {
          "name": "List Rooms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/admin/rooms"
          }
        },
        {
          "name": "Create Room (Generate QR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ruang 11 IPA 1\"\n}"
            },
            "description": "Response berisi qr_string unik yang siap di-encode jadi QR Code dan dicetak/ditempel di ruangan."
          }
        },
        {
          "name": "Update Room",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/rooms/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ruang 10 IPA 1 (Renovasi)\"\n}"
            }
          }
        },
        {
          "name": "Delete (Nonaktifkan) Room",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/admin/rooms/1"
          }
        }
      ]
    },
    {
      "name": "Admin - Schedules (Jadwal)",
      "item": [
        {
          "name": "List Schedules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/admin/schedules"
