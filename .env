APP_PORT=8080

# --- Koneksi Database ---
# Untuk TiDB Cloud (Serverless), isi seperti contoh di bawah. Nilai persis
# (host, user, password) diambil dari tombol "Connect" di dashboard cluster
# kamu di https://tidbcloud.com
#
# Untuk MySQL lokal (XAMPP), lihat contoh yang dikomentari di bawahnya.

# --- TiDB Cloud (Serverless) ---
DB_USER=xxxxxxxx.root
DB_PASSWORD=your_tidb_password
DB_HOST=gateway01.xx-xxxxx-x.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=absensi_guru
DB_TLS_MODE=true

# --- MySQL lokal / XAMPP (uncomment kalau mau pakai ini, lalu comment blok TiDB di atas) ---
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=absensi_guru
# DB_TLS_MODE=false

# WAJIB diganti dengan string acak yang panjang & rahasia di production
JWT_SECRET=ganti-dengan-secret-yang-sangat-rahasia
